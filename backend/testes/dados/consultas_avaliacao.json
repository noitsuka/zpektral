{
  "descricao": "Consultas para medir a busca com scripts/avaliar_busca.py. Os critérios foram escritos a partir do sentido de cada consulta, antes de ver resultados, e são julgamentos por regra aplicados ao título e à marca da oferta: não são rótulos humanos. Uma oferta pode ser o produto certo e ficar de fora porque o título omite um atributo, ou passar por uma peça que a regra não previu.",
  "regras": {
    "texto": "título e marca em minúsculas, sem acentos, com letras e dígitos separados (110V vira 110 v) e tudo que não é letra ou dígito virando espaço",
    "termo": "casa palavras inteiras em sequência; * no fim aceita qualquer final na última palavra; ^ no início exige o termo no começo do título; re: usa expressão regular",
    "exige": "cada grupo precisa de ao menos um dos termos",
    "atributos": "atributo crítico pedido na consulta: precisa de um termo de aceita; um termo de rivais sem nenhum de aceita, ou qualquer termo de exclui, é variante errada",
    "proibe": "qualquer termo torna a oferta irrelevante (peça, acessório, outro produto)",
    "ean": "oferta com este EAN é relevante mesmo que o título não diga",
    "relevante": "todos os grupos de exige, todos os atributos aceitos, nenhum exclui e nenhum proibe",
    "conjunto": "desenvolvimento serve para ajustar a busca; teste só é olhado nas medições finais"
  },
  "grupos": {
    "$cores": [
      "branco", "branca", "preto", "preta", "cinza", "prata", "dourado", "dourada", "rosa", "azul",
