# Banco do histórico de preços. Em produção, PostgreSQL.
DATABASE_URL=postgresql+asyncpg://zpektral:zpektral@localhost:5432/zpektral
# Sem DATABASE_URL o histórico vai para este arquivo SQLite. Vazio desliga o histórico.
ARQUIVO_HISTORICO_LOCAL=zpektral.db
# Dias que o histórico de preços fica guardado.
DIAS_HISTORICO=180

ORIGENS_CORS=["http://localhost:3000"]

# Mercado Livre: app em developers.mercadolivre.com.br e um refresh token obtido no fluxo
# OAuth. O token é renovado sozinho e o mais novo fica salvo em ML_ARQUIVO_TOKEN.
ML_ID_CLIENTE=
ML_SEGREDO_CLIENTE=
ML_TOKEN_RENOVACAO=
ML_ARQUIVO_TOKEN=.ml-token.json

# eBay: app de produção em developer.ebay.com (Application Keys). As ofertas entram como
# importadas, com frete internacional e impostos estimados somados ao total.
EBAY_ID_CLIENTE=
EBAY_SEGREDO=
# Alíquotas da estimativa de importação fora do Remessa Conforme.
ALIQUOTA_IMPOSTO_IMPORTACAO=0.6
ALIQUOTA_ICMS_IMPORTACAO=0.2

# Shopee: credenciais da API de afiliados (affiliate.shopee.com.br).
SHOPEE_ID_APP=
SHOPEE_SEGREDO=

# Busca pública da Amazon (página /s, permitida no robots.txt). false desliga.
AMAZON_BUSCA_PUBLICA=true

# Frete por CEP com navegador (Playwright), sem stealth e sem resolver captcha.
# Precisa de: pip install .[navegador] e playwright install chromium.
# A cotação cabe no SEGUNDOS_LIMITE_FONTE; para cotar mais itens, aumente esse limite.
AMAZON_FRETE_NAVEGADOR=false
SHOPEE_FRETE_NAVEGADOR=false
NAVEGADOR_COTACOES=4
NAVEGADOR_INTERVALO_SEGUNDOS=2
NAVEGADOR_TEMPO_LIMITE_MS=15000
SHOPEE_PAGINAS=2

# Webhook (Discord ou Slack) avisado quando uma loja começa a falhar.
URL_WEBHOOK_ALERTA=

# Atrás de um proxy reverso: o endereço do cliente vem do último valor do X-Forwarded-For,
# o que o próprio proxy acrescenta. Ative só com um proxy na frente da API.
CONFIAR_PROXY=false
HSTS=false
